flowchart TD
    subgraph Client["🌐 Client Layer"]
        direction TB
        Browser["🖥️ Web Browser\nHTML5 + Vanilla JS"]
        MetaMask["🦊 MetaMask Wallet\nEIP-1193 Provider"]
        Mobile["📱 Mobile Responsive\nPWA Ready"]
    end

    subgraph Edge["🔒 Edge & Security"]
        direction TB
        CDN["🌍 Global CDN\nRender/Cloudflare"]
        WAF["🛡️ WAF & DDoS\nRate Limiting"]
        SSL["🔐 TLS 1.3\nHSTS + CSP"]
    end

    subgraph API["⚡ API Gateway\nExpress.js + Socket.IO"]
        direction TB
        Auth["🔐 Auth Service\nJWT + ECDSA"]
        RBAC["👥 RBAC Engine\n8-Role Hierarchy"]
        RateLimit["⏱️ Rate Limiter\nTiered Limits"]
        WebSocket["🔌 WebSocket Server\nReal-time Events"]
    end

    subgraph Services["🔧 Core Services"]
        direction TB
        Evidence["📁 Evidence Service\nUpload/Verify/Export"]
        Case["🗂️ Case Management\nLifecycle + Status"]
        Blockchain["⛓️ Blockchain Service\nPolygon + Smart Contract"]
        IPFS["📦 IPFS Storage\nPinata + CID"]
        Notification["🔔 Notification Service\nEmail + Push + WS"]
        Analytics["📊 Analytics Engine\nMetrics + Monitoring"]
    end

    subgraph Data["💾 Data Layer"]
        direction TB
        Supabase["🐘 Supabase\nPostgreSQL + RLS"]
        Redis["⚡ Redis Cache\nSessions + Rate Limit"]
        Blob["🗄️ Blob Storage\nTemp Files"]
    end

    subgraph Chain["⛓️ Blockchain Layer"]
        direction TB
        Polygon["🔷 Polygon Amoy/Mainnet\nChain ID: 80002/137"]
        Contract["📜 EvidenceStorage.sol\n0x3945...D9e3"]
        Explorer["🔍 Polygonscan\nTx Verification"]
    end

    subgraph Storage["🌐 Decentralized Storage"]
        direction TB
        Pinata["📌 Pinata API\nPinning Service"]
        IPFSNet["🌐 IPFS Network\nContent Addressing"]
        Gateway["🚪 Public Gateway\nRetrieval"]
    end

    %% Connections
    Browser -->|HTTPS/WSS| CDN
    MetaMask -.->|Web3| Browser
    Mobile -->|HTTPS| CDN
    
    CDN --> WAF
    WAF --> SSL
    SSL --> API
    
    API --> Auth
    API --> RBAC
    API --> RateLimit
    API --> WebSocket
    
    Auth --> Supabase
    RBAC --> Supabase
    RateLimit --> Redis
    WebSocket --> Redis
    
    Evidence --> Case
    Evidence --> Blockchain
    Evidence --> IPFS
    Evidence --> Notification
    Case --> Supabase
    Blockchain --> Contract
    Contract --> Polygon
    Polygon --> Explorer
    IPFS --> Pinata
    Pinata --> IPFSNet
    IPFSNet --> Gateway
    
    Analytics --> Supabase
    Analytics --> Redis
    
    Supabase -.->|RLS Policies| Data
    Redis -.->|Cache| Data
    Blob -.->|Temp| Data
    
    %% Styling
    classDef client fill:#1a1f2e,stroke:#36BCF7,stroke-width:2px,color:#e8edf5
    classDef edge fill:#0d1426,stroke:#7C4DFF,stroke-width:2px,color:#e8edf5
    classDef api fill:#1a1f2e,stroke:#00D4FF,stroke-width:2px,color:#e8edf5
    classDef svc fill:#0d1426,stroke:#FF6B6B,stroke-width:2px,color:#e8edf5
    classDef data fill:#1a1f2e,stroke:#00FF88,stroke-width:2px,color:#e8edf5
    classDef chain fill:#0d1426,stroke:#FFA500,stroke-width:2px,color:#e8edf5
    classDef storage fill:#1a1f2e,stroke:#7C4DFF,stroke-width:2px,color:#e8edf5
    
    class Browser,MetaMask,Mobile client
    class CDN,WAF,SSL edge
    class Auth,RBAC,RateLimit,WebSocket api
    class Evidence,Case,Blockchain,IPFS,Notification,Analytics svc
    class Supabase,Redis,Blob data
    class Polygon,Contract,Explorer chain
    class Pinata,IPFSNet,Gateway storage
