            Auditor[("🔍 AUDITOR\nCompliance Review\nAudit Trail\nSystem Integrity\nReports")]
        end
        
        subgraph OperationsTier["🔬 Operational Tier"]
            direction LR
            Analyst[("🔬 FORENSIC ANALYST\nTechnical Analysis\nDeepfake Detection\nMetadata Forensics\nExpert Reports")]
            Investigator[("🕵️ INVESTIGATOR\nCase Creation\nEvidence Upload\nInitial Review\nField Collection")]
        end
        
        subgraph PublicTier["👁️ Public Access Tier"]
            Viewer[("👁️ PUBLIC VIEWER\nBrowse Public Cases\nView Verified Evidence\nTransparency Portal\nRead-Only Access")]
        end
    end
    
